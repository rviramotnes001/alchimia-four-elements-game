[sub_resource type="Shader" id="Shader_m38ye"]
code = "shader_type canvas_item;
void fragment() {
	vec4 c = texture(TEXTURE, UV);
	c.a *= smoothstep(1.0, 0.45, UV.y);
	COLOR = c * COLOR;
}
"

